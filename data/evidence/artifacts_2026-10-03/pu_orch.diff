+            # at the constant instead of quoting it.
+            return False, (
+                f"{self.LIVE_CONFIRMATION_ENV} is enabled but "
+                f"{self.LIVE_CONFIRMATION_TOKEN_ENV} is missing or incorrect "
+                "(set it to the exact acknowledgment sentence documented in "
