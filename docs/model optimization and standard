import networkx as nx
def refine_and_clean_causal_graph(G):
    print(f"Initial Graph State: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges.")
    
    # 1. Identify and break invalid intra-temporal loops (Cycles)
    # Causal DAGs cannot have cycles within the same time-slice
    try:
        while True:
            cycle = nx.find_cycle(G, orienting="original")
            print(f"⚠️ Critical Loop Detected: {cycle}. Breaking edge to restore DAG safety.")
            # Remove the weakest or lowest-weight edge in the loop
            G.remove_edge(cycle[-1][0], cycle[-1][1])
    except nx.NetworkXNoCycle:
        print("🟢 Graph Structural Health: Acyclic (No invalid loops).")

    # 2. Identify and prune dead-end/irrelevant noise nodes (Orphans)
    # Nodes with 0 incoming and 0 outgoing edges that add no context
    orphaned_nodes = [node for node in G.nodes() if G.in_degree(node) == 0 and G.out_degree(node) == 0]
    G.remove_nodes_from(orphaned_nodes)
    print(f"🗑️ Noise Pruning Complete: Removed {len(orphaned_nodes)} irrelevant orphaned nodes.")
    
    print(f"Optimized Graph State: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges.")
    return G
