# --- MT5 (Windows, terminal installed). Leave blank to use the already-logged-in terminal ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Safety: default is PAPER. Live needs BOTH lines. Real (non-demo) accounts need QP_ALLOW_REAL too ---
QP_MODE=paper
QP_LIVE_ENABLED=0
QP_ALLOW_REAL=0

# --- TradingView webhook ---
TV_WEBHOOK_SECRET=change-me-long-random
QP_TV_AUTOEXEC=0
QP_BROKER=ecn_raw
