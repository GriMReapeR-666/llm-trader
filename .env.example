# ============================================================
# LLM Router - Multi-Provider / Multi-Agent Configuration
# ============================================================

# OpenRouter (Aggregator - GPT4, Claude, Llama, Gemini, etc.)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_RPM=60
# Local safety budgets. These are ceilings, not a reason to call the model at
# the full rate; candle/event triggers and deduplication remain in force.
OPENROUTER_RPD=200
OPENROUTER_MAX_CONCURRENT=1
OPENROUTER_MAX_TOKENS_PER_HOUR=120000
OPENROUTER_MAX_COST_PER_DAY=10.0

# TokenRouter (OpenRouter Compatible Aggregator)
TOKENROUTER_KEY=your_tokenrouter_key_here
TOKENROUTER_API_KEY=your_tokenrouter_key_here
TOKENROUTER_RPM=60
TOKENROUTER_RPD=200
TOKENROUTER_MAX_CONCURRENT=1
TOKENROUTER_MAX_TOKENS_PER_HOUR=120000
TOKENROUTER_MAX_COST_PER_DAY=10.0

# RoutesMe AI API Platform (OpenAI-compatible)
ROUTESME_KEY=your_routesme_key_here
ROUTESME_API_KEY=your_routesme_key_here
ROUTESME_BASE_URL=https://routesme.online/v1
ROUTESME_RPM=20
ROUTESME_RPD=200
ROUTESME_MAX_CONCURRENT=1
ROUTESME_MAX_TOKENS_PER_HOUR=400000
ROUTESME_MAX_COST_PER_DAY=10.0

# Cerebras AI (Fast Inference - Free Llama 3.1 & 3.3)
CEREBRAS_API_KEY=your_cerebras_key_here
CEREBRAS_RPM=30
CEREBRAS_RPD=200
CEREBRAS_MAX_CONCURRENT=1
CEREBRAS_MAX_TOKENS_PER_HOUR=120000
CEREBRAS_MAX_COST_PER_DAY=10.0

# NVIDIA NIM (Fast Inference - Llama, DeepSeek, etc.)
NVIDIA_KEY_1=your_nvidia_key_here
NVIDIA_KEY_2=your_second_nvidia_key_here
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_RPM=60
NVIDIA_RPD=200
NVIDIA_MAX_CONCURRENT=1
NVIDIA_MAX_TOKENS_PER_HOUR=120000
NVIDIA_MAX_COST_PER_DAY=10.0

# ============================================================
# Agent-Specific LLM Routing
# Each agent can use a different provider/model
# ============================================================
TRADER_LLM_PROVIDER=openrouter
TRADER_LLM_MODEL=mistralai/mistral-7b-instruct-v0.2
TRADER_LLM_FALLBACK=cerebras,nvidia_nim

ANALYST_LLM_PROVIDER=cerebras
ANALYST_LLM_MODEL=llama3.1-70b
ANALYST_LLM_FALLBACK=openrouter,nvidia_nim

RISK_LLM_PROVIDER=nvidia_nim
RISK_LLM_MODEL=meta/llama-3.1-70b-instruct
RISK_LLM_FALLBACK=openrouter,cerebras

# ============================================================
# Provider Failover Policy & LLM Request Tuning
# ============================================================
# Default false: the selected provider is authoritative and its failure
# becomes a deterministic HOLD decision (fail-closed trade safety).
# Set true to allow falling back to TRADER/ANALYST/RISK_LLM_FALLBACK
# providers when the primary provider fails.
LLM_TRADER_ALLOW_PROVIDER_FAILOVER=false

# Cap per-call LLM blocking so a slow/saturated provider cannot freeze the
# market pulse thread (defaults shown; seconds).
LLM_ROUTER_TIMEOUT=30
LLM_ROUTER_MAX_RATE_WAIT=15

# Per-provider default model ids used when failing over across providers,
# so a fallback receives a model id its own API actually serves.
# LLM_ROUTER_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
# LLM_ROUTER_MODEL_NVIDIA_NIM=meta/llama-3.2-11b-vision-instruct
# LLM_ROUTER_MODEL_CEREBRAS=gemma-4-31b

# ============================================================
# MT5 Credentials
# ============================================================
MT5_LOGIN=123456
MT5_PASSWORD=your_password
MT5_SERVER=your_server_name
# Broker-calibrated cost assumptions used by the live/demo net-RR gate.
# Leave unset to force NO_TRADE until verified for the selected broker/symbol.
MT5_COMMISSION_PER_VOLUME=
MT5_EXPECTED_SLIPPAGE_PRICE=
MT5_EXPECTED_SWAP_MONEY=

# Live automated LLM trading remains disabled unless this explicit opt-in is
# present as well as --live and either --yes or the interactive confirmation.
LLM_TRADER_ALLOW_LIVE=false

# ============================================================
# Economic Data APIs
# ============================================================
NEWSAPI_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_key_here

# ============================================================
# Rate Limits
# ============================================================
NEWSAPI_RATE_LIMIT=999
FRED_RATE_LIMIT=1200
SEC_RATE_LIMIT=600


# ============================================================
# Optional Remote Mirror (MySQL) agent-memory mirror
# Local SQLite (TradingMemory / AgentOperations) stays authoritative.
# Disabled by default. Never grants execution_authority.
# Requires: pip install pymysql
# ============================================================
REMOTE_MIRROR_ENABLED=false  
REMOTE_MIRROR_ON_WRITE=false
REMOTE_MIRROR_HOST=
REMOTE_MIRROR_PORT=3306
REMOTE_MIRROR_USER=
REMOTE_MIRROR_PASSWORD=
REMOTE_MIRROR_DATABASE=
REMOTE_MIRROR_TABLE_PREFIX=llm_trader_
REMOTE_MIRROR_CONNECT_TIMEOUT=3
# Local only, no cloud required

# ============================================================
# Local Agent Memory (OFFLINE SQLite — no cloud)
# Document/KV layout; local only, no cloud.
# Disabled by default. Never grants execution_authority.
# ============================================================
LOCAL_MEMORY_ENABLED=false  
LOCAL_MEMORY_PATH=local_agent_memory.db
LOCAL_MEMORY_MAX_ACTIVE=5000
LOCAL_MEMORY_RETENTION_DAYS=90
LOCAL_MEMORY_COMPACT_KEEP=200

# ============================================================
# MT5 MCP Bridge (metatrader5-mcp via @modelcontextprotocol/sdk)
# ============================================================
# Command Deck can consume live MT5 via the installed metatrader5-mcp
# FastMCP server over stdio (see opencode.json "mcp.metatrader5").
# TRANSPORT=mcp  → deck spawns: python -m metatrader5_mcp.main
# Also works via: TRANSPORT=mcp bun src/index.tsx  (tui_opentui)
# Or auto-sidecar: MT5_MCP_AUTOSTART=1 with TRANSPORT=live
MT5_MCP_COMMAND=python
MT5_MCP_ARGS=-m metatrader5_mcp.main
# MT5_MCP_AUTOSTART=1  # set to 1 to also poll MT5 when TRANSPORT=live
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe  # optional MT5 terminal path

# ============================================================
# General
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# Sieve web-scrape API (server-side only)
# ============================================================
# Full-account key. Server-side ONLY: never in a browser/mobile bundle, logs,
# analytics, error reports, or git. Leave empty to keep Sieve disabled - the
# sieve_poll schedule then no-ops and live trading behavior is unchanged.
# Obtain via device login: python scripts/sieve_login.py (writes the key to the
# encrypted secure store) or Settings -> API keys on scrape.usesieve.com.
SIEVE_API_KEY=
SIEVE_BASE_URL=https://scrape.usesieve.com
# Run-record sqlite file for crash-safe resume polling (gitignored).
SIEVE_DB=sieve_runs.db
